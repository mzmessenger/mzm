{
  "private": true,
  "name": "mzm",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:workers-builds": "node --test scripts/deploy-workers-builds.test.mjs",
    "verify:workers-builds": "npm run test:workers-builds && npm run build -w packages/shared && npm run lint -w packages/queue-worker && npm test -w packages/queue-worker && npm run build -w packages/queue-worker && npm run lint -w packages/event-gateway-worker && npm test -w packages/event-gateway-worker && npm run build -w packages/event-gateway-worker",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "start": "concurrently -k -c \"auto\" npm:start:events npm:start:auth npm:start:backend npm:start:frontend",
    "start:without:frontend": "concurrently -k -c \"auto\" npm:start:events npm:start:auth npm:start:backend",
    "start:events": "npm run start:event-gateway",
    "start:auth": "npm start -w packages/auth",
    "start:event-gateway": "npm start -w packages/event-gateway-worker",
    "start:backend": "npm start -w packages/backend",
    "start:frontend": "npm start -w packages/frontend",
    "build-docker-image:auth": "docker build -f packages/auth/Dockerfile -t mzm-auth .",
    "build-docker-image:backend": "docker build -f packages/backend/Dockerfile -t mzm-backend .",
    "build-docker-image:frontend": "docker build -f packages/frontend/Dockerfile -t mzm-frontend ."
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "concurrently": "^9.2.1",
    "mzm-auth": "^1.0.1",
    "mzm-frontend": "^0.0.0",
    "prettier": "^3.8.3"
  }
}
