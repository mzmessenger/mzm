{
  "private": true,
  "name": "mzm-auth",
  "version": "1.0.1",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prestart": "npm run cleanbuild",
    "start": "node --env-file=.env --watch dist/src/server.js | bunyan",
    "dev": "npm run start",
    "cleanbuild": "rm -rf dist && npm run build",
    "build": "tsc --build tsconfig.json",
    "build:test": "tsc --build tsconfig.test.json",
    "format": "prettier --write src test ./*.{js,json}",
    "lint": "eslint -c eslint.config.mjs .",
    "pretest": "concurrently \"npm run lint\" \"npm run build:test\"",
    "test": "vitest run --config ./vitest.config.ts",
    "test:ci": "vitest run --config ./vitest.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "bunyan": "^1.8.15",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "passport": "^0.7.0",
    "passport-github": "^1.1.0",
    "passport-twitter": "^1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bunyan": "^1.8.11",
    "@types/cors": "^2.8.19",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-github": "^1.1.13",
    "@types/passport-twitter": "^1.0.40",
    "eslint": "^9.39.4",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  }
}
