{
  "compilerOptions": {
    "incremental": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "./",
    "sourceMap": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "mzm-shared": ["../shared"]
    }
  },
  "exclude": ["node_modules", "**/*.test.ts", "test/**/*"],
  "references": [{ "path": "../shared" }]
}
