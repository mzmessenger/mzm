{
  "private": true,
  "name": "mzm-queue-worker",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "wrangler dev --local --inspector-port 9231 --var AUTH_SERVICE_URL:http://127.0.0.1:3002 --var BACKEND_SERVICE_URL:http://127.0.0.1:3001 --var QUEUE_CALLBACK_SECRET:local-queue-secret",
    "dev": "npm run start",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint -c eslint.config.mjs .",
    "test": "vitest run",
    "types": "wrangler types src/worker-configuration.d.ts"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7",
    "wrangler": "4.107.0"
  }
}
