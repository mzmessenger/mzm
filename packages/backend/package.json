{
  "private": true,
  "name": "mzm-backend",
  "version": "0.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prestart": "npm run cleanbuild",
    "start": "node --env-file-if-exists=.env --watch dist/src/server.js | bunyan",
    "dev": "npm run start",
    "build": "tsc --build tsconfig.json",
    "build:test": "tsc --build tsconfig.test.json",
    "cleanbuild": "rm -rf dist/ && npm run build",
    "format": "prettier --write src ./*.{js,json}",
    "lint": "eslint -c eslint.config.mjs .",
    "pretest": "concurrently \"npm run lint\" \"npm run build:test\"",
    "test:ci": "vitest run --config=./vitest.config.js",
    "test": "vitest run --config=./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@elastic/elasticsearch": "^7.17.14",
    "bunyan": "^1.8.15",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "multer": "^2.1.1",
    "node-schedule": "^2.1.1",
    "undici": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bunyan": "^1.8.11",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node-schedule": "^2.1.8",
    "eslint": "^9.39.4",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  }
}
