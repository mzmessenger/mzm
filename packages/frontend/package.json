{
  "private": true,
  "name": "mzm-frontend",
  "version": "0.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prestart": "npm run build:tsc",
    "start": "vite",
    "dev": "npm run start",
    "serve": "vite preview --port 8080",
    "format": "prettier --write src ./*.{js,json}",
    "lint": "eslint -c eslint.config.mjs .",
    "pretest": "npm run build:tsc",
    "test": "vitest run --config=./vite.config.ts",
    "test:warth": "vitest --config=./vite.config.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "vite build",
    "prebuild:tsc": "npm run clean",
    "build:tsc": "tsc --build tsconfig.json",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy --minify"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.6.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.0"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@types/node": "^25.9.1",
    "comlink": "^4.4.2",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.5",
    "highlight.js": "^11.11.1",
    "jotai": "^2.20.0",
    "jsdom": "^29.1.1",
    "jwt-decode": "^4.0.0",
    "lindera-wasm-ipadic": "^0.45.0",
    "marked": "^18.0.4",
    "marked-mangle": "^1.1.13",
    "normalize.css": "^8.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1",
    "validator": "^13.15.35"
  }
}
