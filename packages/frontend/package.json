{
  "private": true,
  "name": "mzm-frontend",
  "version": "0.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prestart": "npm run build:tsc",
    "start": "vite",
    "dev": "npm run start",
    "serve": "vite preview --port 8080",
    "format": "prettier --write src ./*.{js,json}",
    "lint": "eslint -c eslint.config.mjs .",
    "pretest": "npm run build:tsc",
    "test": "vitest run --config=./vite.config.ts",
    "test:warth": "vitest --config=./vite.config.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "vite build",
    "prebuild:tsc": "npm run clean",
    "build:tsc": "tsc --build tsconfig.json",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy --minify"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/dompurify": "^3.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.84.1"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@types/node": "^25.6.0",
    "comlink": "^4.3.2",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.1",
    "highlight.js": "^11.11.1",
    "jotai": "^2.19.1",
    "jsdom": "^29.0.2",
    "jwt-decode": "^4.0.0",
    "lindera-wasm-ipadic": "^0.45.0",
    "marked": "^18.0.2",
    "marked-mangle": "^1.1.13",
    "normalize.css": "^8.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "validator": "^13.15.35"
  }
}
